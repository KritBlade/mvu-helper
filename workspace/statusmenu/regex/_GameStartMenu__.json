  "find_regex": "<GameStartMenu/>",
  "replace_string": "<div class=\"mvu-helper-region\" data-mvu-helper=\"game-start-menu\" data-mvu-helper-contract=\"move or hide this element whole - do not walk into it\">\n\n<!-- mvu-helper:begin game-start-menu -->\n\n```\n<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>Character Creation</title>\n</head>\n<body>\n    <style>\n        /* The status menu's palette (layout-schoolv4.json globalCss): the two screens read as one card. */\n        :root {\n            --text-primary: #1b2e23;\n            --text-secondary: #536a5d;\n            --accent-primary: #1e7d4b;\n            --border-color: rgba(30, 125, 75, 0.25);\n            --background-card: #eeeeee;\n        }\n        * { box-sizing: border-box; }\n        body {\n            margin: 0; padding: 10px;\n            font-family: 'Segoe UI', sans-serif; font-size: 16px;\n            background: transparent; color: var(--text-primary);\n        }\n        .gs-frame {\n            background: linear-gradient(-45deg, #cfe9d9, #dff2e6, #cde6d6, #e4f5ea);\n            background-size: 400% 400%;\n            animation: gs-gradient-flow 30s ease infinite;\n            border: 1px solid var(--border-color);\n            border-radius: 8px;\n            padding: 10px;\n        }\n        @keyframes gs-gradient-flow {\n            0% { background-position: 0% 50%; }\n            50% { background-position: 100% 50%; }\n            100% { background-position: 0% 50%; }\n        }\n        .gs-card {\n            background: var(--background-card);\n            border: 1px solid var(--border-color);\n            border-radius: 6px;\n            padding: 12px 14px;\n        }\n        .gs-header {\n            color: var(--accent-primary); font-weight: bold; font-size: 1.15em;\n            border-bottom: 1px solid var(--border-color);\n            padding-bottom: 6px; margin-bottom: 8px;\n        }\n        .gs-sub { margin: 0 0 14px; color: var(--text-secondary); font-size: 0.9em; }\n\n        .gs-field { display: flex; align-items: center; margin-bottom: 10px; }\n        .gs-field label { flex: 0 0 110px; font-weight: bold; font-size: 0.95em; color: var(--text-secondary); }\n        .gs-input, .gs-select {\n            flex: 1; max-width: 260px;\n            background: #ffffff; color: var(--text-primary);\n            border: 1px solid var(--border-color); border-radius: 4px;\n            padding: 6px 10px; font: inherit; font-size: 0.9em;\n        }\n        .gs-input:focus, .gs-select:focus { outline: none; border-color: var(--accent-primary); }\n        .gs-input.is-short { max-width: 100px; }\n\n        .gs-stats {\n            background: rgba(30, 125, 75, 0.07);\n            border: 1px solid rgba(30, 125, 75, 0.15);\n            border-radius: 6px;\n            padding: 12px; margin: 14px 0; max-width: 420px;\n        }\n        .gs-stats-header {\n            display: flex; justify-content: space-between; align-items: baseline;\n            color: var(--accent-primary); font-weight: bold; font-size: 0.9em;\n            text-transform: uppercase; letter-spacing: 0.5px;\n            border-bottom: 1px solid var(--border-color);\n            padding-bottom: 4px; margin-bottom: 10px;\n        }\n        .gs-stats-header .gs-budget { text-transform: none; letter-spacing: 0; }\n        .gs-stat { display: flex; align-items: center; gap: 8px; margin-bottom: 8px; }\n        .gs-stat-name { flex: 0 0 110px; font-weight: bold; font-size: 0.9em; color: var(--text-secondary); }\n        .gs-stat-name small { display: block; font-weight: normal; font-size: 0.8em; }\n        .gs-step {\n            width: 28px; height: 28px; padding: 0;\n            display: flex; align-items: center; justify-content: center;\n            background: transparent; color: var(--accent-primary);\n            border: 1px solid var(--accent-primary); border-radius: 4px;\n            font-weight: bold; font-size: 1em; cursor: pointer;\n        }\n        .gs-step:hover:not(:disabled) { background: rgba(30, 125, 75, 0.12); }\n        .gs-step:disabled { border-color: #b3c9bb; color: #b3c9bb; cursor: not-allowed; }\n        .gs-stat-value {\n            width: 64px; text-align: center; font-weight: bold; font: inherit; font-size: 0.95em;\n            background: #ffffff; color: var(--text-primary);\n            border: 1px solid var(--border-color); border-radius: 4px; padding: 4px 6px;\n        }\n        .gs-stat-value:focus { outline: none; border-color: var(--accent-primary); }\n        .gs-stat-value:disabled { color: var(--text-secondary); background: transparent; }\n\n        .gs-confirm {\n            width: 100%; max-width: 420px; padding: 10px 18px;\n            background: rgba(30, 125, 75, 0.12); color: var(--accent-primary);\n            border: 1px solid var(--accent-primary); border-radius: 4px;\n            font: inherit; font-weight: bold; font-size: 1.05em; cursor: pointer;\n        }\n        .gs-confirm:hover:not(:disabled) { background: rgba(30, 125, 75, 0.25); }\n        .gs-confirm:disabled { background: rgba(30, 125, 75, 0.05); color: #5e7567; border-color: #b3c9bb; cursor: not-allowed; }\n        .gs-status { margin-top: 10px; min-height: 18px; font-size: 0.9em; color: var(--text-secondary); }\n        .gs-status.is-error { color: #c62828; }\n        .gs-status.is-success { color: var(--accent-primary); font-weight: bold; }\n    </style>\n\n    <div class=\"gs-frame\">\n        <div class=\"gs-card\">\n            <div class=\"gs-header\">Character Creation</div>\n            <p class=\"gs-sub\">Set your name and starting attributes. Every one of the 200 points must be placed before you can start.</p>\n\n            <div class=\"gs-field\">\n                <label for=\"gs-name\">Name</label>\n                <input id=\"gs-name\" type=\"text\" class=\"gs-input gs-name\" value=\"{{user}}\" placeholder=\"Enter name\">\n            </div>\n            <div class=\"gs-field\">\n                <label for=\"gs-age\">Age</label>\n                <input id=\"gs-age\" type=\"text\" class=\"gs-input gs-age is-short\" value=\"18\" placeholder=\"18\">\n            </div>\n            <div class=\"gs-field\">\n                <label for=\"gs-gender\">Gender</label>\n                <select id=\"gs-gender\" class=\"gs-select gs-gender\">\n                    <option value=\"Male\">Male</option>\n                    <option value=\"Female\">Female</option>\n                </select>\n            </div>\n            <div class=\"gs-field\">\n                <label for=\"gs-race\">Race</label>\n                <input id=\"gs-race\" type=\"text\" class=\"gs-input gs-race\" value=\"Human\" placeholder=\"Human\">\n            </div>\n\n            <div class=\"gs-stats\">\n                <div class=\"gs-stats-header\">\n                    <span>Attributes</span>\n                    <span class=\"gs-budget\">Points remaining: <span class=\"gs-points\">170</span> / 200</span>\n                </div>\n\n                <div class=\"gs-stat\" data-stat=\"Str\">\n                    <div class=\"gs-stat-name\">Strength</div>\n                    <button type=\"button\" class=\"gs-step gs-minus\" aria-label=\"Strength minus one\">-</button>\n                    <input type=\"number\" class=\"gs-stat-value\" value=\"0\" min=\"0\" max=\"100\" step=\"1\" aria-label=\"Strength\">\n                    <button type=\"button\" class=\"gs-step gs-plus\" aria-label=\"Strength plus one\">+</button>\n                </div>\n                <div class=\"gs-stat\" data-stat=\"Sta\">\n                    <div class=\"gs-stat-name\">Stamina <small>minimum 30</small></div>\n                    <button type=\"button\" class=\"gs-step gs-minus\" aria-label=\"Stamina minus one\">-</button>\n                    <input type=\"number\" class=\"gs-stat-value\" value=\"30\" min=\"30\" max=\"100\" step=\"1\" aria-label=\"Stamina\">\n                    <button type=\"button\" class=\"gs-step gs-plus\" aria-label=\"Stamina plus one\">+</button>\n                </div>\n                <div class=\"gs-stat\" data-stat=\"Int\">\n                    <div class=\"gs-stat-name\">Intelligence</div>\n                    <button type=\"button\" class=\"gs-step gs-minus\" aria-label=\"Intelligence minus one\">-</button>\n                    <input type=\"number\" class=\"gs-stat-value\" value=\"0\" min=\"0\" max=\"100\" step=\"1\" aria-label=\"Intelligence\">\n                    <button type=\"button\" class=\"gs-step gs-plus\" aria-label=\"Intelligence plus one\">+</button>\n                </div>\n                <div class=\"gs-stat\" data-stat=\"Cha\">\n                    <div class=\"gs-stat-name\">Charisma</div>\n                    <button type=\"button\" class=\"gs-step gs-minus\" aria-label=\"Charisma minus one\">-</button>\n                    <input type=\"number\" class=\"gs-stat-value\" value=\"0\" min=\"0\" max=\"100\" step=\"1\" aria-label=\"Charisma\">\n                    <button type=\"button\" class=\"gs-step gs-plus\" aria-label=\"Charisma plus one\">+</button>\n                </div>\n            </div>\n\n            <button type=\"button\" class=\"gs-confirm\">Place 170 more points to start</button>\n            <div class=\"gs-status\"></div>\n        </div>\n    </div>\n\n    <script>\n        (function () {\n            // The budget. Sta's minimum is pre-placed, so 170 remain to spend; a stat caps at 100.\n            const TOTAL_POINTS = 200;\n            const STAT_MAX = 100;\n            const STAT_MIN = { Str: 0, Sta: 30, Int: 0, Cha: 0 };\n            const STAT_LABEL = { Str: 'Strength', Sta: 'Stamina', Int: 'Intelligence', Cha: 'Charisma' };\n\n            const card = document.querySelector('.gs-card');\n            const find = (selector) => card.querySelector(selector);\n            const rows = Array.from(card.querySelectorAll('.gs-stat'));\n            const pointsEl = find('.gs-points');\n            const confirmBtn = find('.gs-confirm');\n            const statusEl = find('.gs-status');\n            const identityInputs = ['.gs-name', '.gs-age', '.gs-gender', '.gs-race'].map(find);\n            let isLocked = false;\n\n            const clamp = (n, low, high) => Math.min(high, Math.max(low, n));\n            const statOf = (row) => row.dataset.stat;\n            const inputOf = (row) => row.querySelector('.gs-stat-value');\n            const readStat = (row) => {\n                const min = STAT_MIN[statOf(row)];\n                const typed = parseInt(inputOf(row).value, 10);\n                return clamp(Number.isFinite(typed) ? typed : min, min, STAT_MAX);\n            };\n            const writeStat = (row, value) => { inputOf(row).value = String(value); };\n            const spent = () => rows.reduce((sum, row) => sum + readStat(row), 0);\n\n            function setStatus(text, kind) {\n                statusEl.textContent = text;\n                statusEl.className = 'gs-status' + (kind ? ' is-' + kind : '');\n            }\n\n            // Every control's state follows from the budget; nothing else decides it.\n            function refresh() {\n                const remaining = TOTAL_POINTS - spent();\n                pointsEl.textContent = String(remaining);\n                rows.forEach((row) => {\n                    const value = readStat(row);\n                    row.querySelector('.gs-minus').disabled = isLocked || value <= STAT_MIN[statOf(row)];\n                    row.querySelector('.gs-plus').disabled = isLocked || remaining <= 0 || value >= STAT_MAX;\n                    inputOf(row).disabled = isLocked;\n                });\n                identityInputs.forEach((input) => { input.disabled = isLocked; });\n                if (isLocked) {\n                    confirmBtn.disabled = true;\n                    confirmBtn.textContent = 'Already started';\n                    return remaining;\n                }\n                confirmBtn.disabled = remaining !== 0;\n                confirmBtn.textContent = remaining > 0\n                    ? 'Place ' + remaining + ' more point' + (remaining === 1 ? '' : 's') + ' to start'\n                    : 'Confirm & Start';\n                return remaining;\n            }\n\n            // A typed value settles into its range, then into what is left to spend.\n            function settle(row) {\n                const others = spent() - readStat(row);\n                const value = clamp(readStat(row), STAT_MIN[statOf(row)], Math.min(STAT_MAX, TOTAL_POINTS - others));\n                writeStat(row, value);\n                refresh();\n            }\n\n            function step(row, delta) {\n                if (isLocked) return;\n                const value = readStat(row);\n                const remaining = TOTAL_POINTS - spent();\n                const ceiling = Math.min(STAT_MAX, value + Math.max(0, remaining));\n                writeStat(row, clamp(value + delta, STAT_MIN[statOf(row)], ceiling));\n                refresh();\n            }\n\n            rows.forEach((row) => {\n                row.querySelector('.gs-minus').addEventListener('click', () => step(row, -1));\n                row.querySelector('.gs-plus').addEventListener('click', () => step(row, 1));\n                inputOf(row).addEventListener('input', refresh);\n                inputOf(row).addEventListener('change', () => settle(row));\n            });\n\n            // ---- the host ----------------------------------------------------------------------\n            // This form runs in mvu-helper's contained frame: an opaque origin with no parent to reach.\n            // It READS the state the host baked in and pushes (getVariables is defined in the frame\n            // before this script runs) and WRITES by posting ONE action to mvu-helper's dispatcher,\n            // which runs the StatusMenu Engine's `startGame`: the engine judges the write, the form\n            // reports what the player chose.\n            const ACTION_MESSAGE = 'mvu-statusmenu-action';\n            const ACTION_TIMEOUT_MS = 8000;\n            let actionSeq = 0;\n            const isTrue = (value) => {\n                const raw = Array.isArray(value) ? value[0] : value;\n                return raw === true || raw === 1 || raw === 'true';\n            };\n\n            // SaveInfo.GameStarted is the card's own flag (statdata_schema.txt); once it is set the\n            // screen is a record, not a form.\n            function readStartedFlag() {\n                if (typeof getVariables !== 'function') return false;\n                const vars = getVariables();\n                return isTrue(vars && vars.stat_data && vars.stat_data.SaveInfo && vars.stat_data.SaveInfo.GameStarted);\n            }\n\n            // One action, one answer: the dispatcher replies to THIS frame with the same requestId.\n            function postAction(action, args) {\n                return new Promise((resolve, reject) => {\n                    const requestId = 'game-start-' + (++actionSeq) + '-' + Date.now();\n                    const timer = setTimeout(() => {\n                        window.removeEventListener('message', onReply);\n                        reject(new Error('mvu-helper did not answer within ' + (ACTION_TIMEOUT_MS / 1000) + 's - is it installed and enabled?'));\n                    }, ACTION_TIMEOUT_MS);\n                    function onReply(event) {\n                        const data = event && event.data;\n                        if (!data || data.type !== ACTION_MESSAGE + '-result' || data.requestId !== requestId) return;\n                        clearTimeout(timer);\n                        window.removeEventListener('message', onReply);\n                        if (data.ok) resolve(data);\n                        else reject(new Error(data.reason || 'refused'));\n                    }\n                    window.addEventListener('message', onReply);\n                    window.top.postMessage({ type: ACTION_MESSAGE, requestId, action, args }, '*');\n                });\n            }\n\n            async function persist(character) {\n                await postAction('startGame', character);\n            }\n\n            confirmBtn.addEventListener('click', async () => {\n                if (isLocked) return;\n                if (refresh() !== 0) {\n                    setStatus('Place every point before starting.', 'error');\n                    return;\n                }\n                const character = {\n                    name: find('.gs-name').value.trim() || '{{user}}',\n                    age: find('.gs-age').value.trim() || '18',\n                    gender: find('.gs-gender').value,\n                    race: find('.gs-race').value.trim() || 'Human',\n                    stats: Object.fromEntries(rows.map((row) => [statOf(row), readStat(row)])),\n                };\n                confirmBtn.disabled = true;\n                setStatus('Saving…');\n                try {\n                    await persist(character);\n                    isLocked = true;\n                    refresh();\n                    setStatus('Character saved. Send your first message to begin.', 'success');\n                } catch (err) {\n                    console.error('[GameStart] save failed:', err);\n                    setStatus('Save failed: ' + err.message, 'error');\n                    refresh();\n                }\n            });\n\n            // The state is in the frame before this script runs, so the flag is read at once; a later\n            // push (the same chat saving the character another way) locks the form too.\n            isLocked = readStartedFlag();\n            refresh();\n            if (isLocked) setStatus('Character already created. Values are locked.');\n            if (typeof eventOn === 'function' && window.Mvu && window.Mvu.events) {\n                eventOn(window.Mvu.events.VARIABLE_UPDATE_ENDED, () => {\n                    if (isLocked || !readStartedFlag()) return;\n                    isLocked = true;\n                    refresh();\n                    setStatus('Character already created. Values are locked.');\n                });\n            }\n        })();\n    </script>\n</body>\n</html>\n```\n\n<!-- mvu-helper:end game-start-menu -->\n\n</div>",
